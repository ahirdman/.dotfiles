# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# Machine-specific hosts kept out of git. Must stay above the Host blocks.
Include ~/.ssh/config.local

# Linked only by the work layer. Must stay above the Host blocks.
Include ~/.ssh/config.work

Host personalgit
    HostName github.com
    User git
    IdentityFile ~/.ssh/personal_git.pub
    IdentitiesOnly yes

# Home Assistant on the LAN, resolved over mDNS.
Host ha
    HostName homeassistant.local
    User hassio
    Port 22
    SetEnv TERM=xterm-256color
    IdentityAgent SSH_AUTH_SOCK
    IdentityFile ~/.ssh/ha_keychain_ed25519
    IdentitiesOnly yes

# Home Assistant over Tailscale, resolved by MagicDNS without the tailnet name.
Host ha-ts
    HostName homeassistant
    User hassio
    Port 22
    SetEnv TERM=xterm-256color
    IdentityAgent SSH_AUTH_SOCK
    IdentityFile ~/.ssh/ha_keychain_ed25519
    IdentitiesOnly yes

# Load only the HA key from macOS login Keychain into the native SSH agent.
# The encrypted private key remains local; other hosts still use 1Password.
Match originalhost ha,ha-ts exec "~/.ssh/ha_native_agent_load.py"
    AddKeysToAgent yes

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
