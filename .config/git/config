[alias]
	aa = "add --all"
	ap = "add --patch"
  ca = "commit --amend"
	ci = "commit -v"
	co = "checkout"
	ls = "branch -v"
	pb = "!git fetch -p && git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" {print $1}' | xargs -r git branch -D"
	pf = "push --force-with-lease"
	st = "status"
	undo = "reset --soft HEAD^"

[log]
    abbrevCommit = true  # short commits
    #graphColors = blue,yellow,cyan,magenta,green,red

[status]
    branch = true
    short = true
    showStash = true
    showUntrackedFiles = all  # show individual untracked files

[commit]
	template = "~/.config/git/template"

[core]
	editor = "nvim"

[fetch]
	prune = true

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[push]
	autoSetupRemote = true

