[alias]
	aa = "add --all"
	ap = "add --patch"
  ca = "commit --amend"
	ci = "commit -v"
	co = "checkout"
	ls = "branch -v"
	pb = "!git fetch -p && git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" {print $1}' | xargs -r git branch -D"
	pf = "push --force-with-lease"
	st = "status"
	undo = "reset --soft HEAD^"

[log]
    abbrevCommit = true  # short commits
    #graphColors = blue,yellow,cyan,magenta,green,red

[status]
    branch = true
    short = true
    showStash = true
    showUntrackedFiles = all  # show individual untracked files

[commit]
	template = "~/.config/git/template"

[core]
	editor = "nvim"
	pager = "if command -v delta >/dev/null 2>&1; then delta; else less; fi"

[interactive]
	diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi"

[delta]
	navigate = true

[diff]
	algorithm = histogram

[merge]
	conflictStyle = zdiff3

[rerere]
	enabled = true

[rebase]
	autoStash = true

[branch]
	sort = -committerdate

[fetch]
	prune = true

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[user]
	email = "88927248+ahirdman@users.noreply.github.com"
	name = "Alexander Hirdman"
# Machine layers can replace the default identity.
[include]
	path = ~/.config/git-machine
[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.config/git/personal
[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.config/git/dotfiles
[includeIf "gitdir:~/Developer/personal/"]
	path = ~/.config/git/personal
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
