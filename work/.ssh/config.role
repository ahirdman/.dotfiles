# Device keys on disk, outside 1Password, so git works without Touch ID.
# github.com is the work account. git-machine sends ahirdman repos to personalgit.
Host github.com
    User git
    IdentityFile ~/.ssh/git_work
    IdentitiesOnly yes
    IdentityAgent none

Host personalgit
    HostName github.com
    User git
    IdentityFile ~/.ssh/git_personal
    IdentitiesOnly yes
    IdentityAgent none
